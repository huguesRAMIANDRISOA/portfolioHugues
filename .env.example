# EmailJS — https://dashboard.emailjs.com (offre gratuite : 200 emails / mois, 2 modèles)
# Copier ce fichier en `.env.local` et renseigner les valeurs. Voir emails/README.md.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
# ID du modèle « NOTIFICATION » (celui qui a « AUTO REPLY » en auto-reply)
VITE_EMAILJS_TEMPLATE_ID=

# URL publique du site utilisée dans les liens des emails (sinon : l'adresse courante, ex. localhost en dev)
VITE_SITE_URL=
